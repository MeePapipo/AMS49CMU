dist/

# ---- ความลับ ----
# .dev.vars มีรหัสผ่านแอดมินตอน dev และคีย์เซ็น session — ห้าม commit เด็ดขาด
.dev.vars
.dev.vars.*
.env
.env.*
*.pem

